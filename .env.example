# =====================================================================
# Arabic Video Brief - Environment Configuration Template
# Copy this file to '.env' and insert your actual API keys.
# DO NOT COMMIT OR UPLOAD YOUR REAL '.env' FILE TO GITHUB!
# =====================================================================

# LLM & Search API Keys
GEMINI_API_KEY=your_gemini_api_key_here
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
Seekai_api=your_seekai_api_key_here
VyceAI_api=your_vyceai_api_key_here

# Model Configuration
VyceAI_Model=gpt-5.6-luna
SEEKAI_MODEL=deepseek-v4-flash
# GEMINI_MODEL=gemini-3.6-flash
# LLM_PROVIDER=vyceai  # Options: vyceai, seekai, gemini, brainstorm

# Optional System Overrides
# FFMPEG_BINARY=D:\Automation\arabic-video-brief\bin\ffmpeg.exe
# ARABIC_VIDEO_BRIEF_FONT=assets/NotoSansArabic-SemiBold.ttf
# ARABIC_VIDEO_BRIEF_BROWSER_PROFILE=assets/browser_profile

